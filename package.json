{
  "name": "board-game-assistant",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve-static.js",
    "build": "node scripts/build-static.js",
    "sync:android": "npm run build && npx cap sync android",
    "sync:ios": "npm run build && npx cap sync ios",
    "build:android:debug": "node scripts/build-android-debug.js",
    "build:android:release": "node scripts/build-android-release.js",
    "preview": "node scripts/serve-static.js dist",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:e2e": "node tests/e2e/run-e2e.js",
    "test": "npm run test:unit && npm run test:e2e",
    "check": "npm run build && npm test",
    "assets:store": "node scripts/generate-store-assets.js"
  },
  "devDependencies": {
    "playwright": "^1.59.1"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/local-notifications": "^8.2.1"
  }
}
