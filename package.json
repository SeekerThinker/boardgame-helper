{
  "name": "board-game-assistant",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve-static.js",
    "build": "node scripts/build-static.js",
    "sync:android": "npm run build && npx cap sync android",
    "sync:ios": "npm run build && npx cap sync ios",
    "build:android:debug": "node scripts/build-android-debug.js",
    "build:android:release": "node scripts/build-android-release.js",
    "preview": "node scripts/serve-static.js dist",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:e2e": "node tests/e2e/run-e2e.js && node tests/e2e/run-table-os-e2e.js && node tests/e2e/run-table-os-import-safety-e2e.js && node tests/e2e/run-table-os-status-e2e.js && node tests/e2e/run-table-os-entities-e2e.js && node tests/e2e/run-table-os-companion-e2e.js && node tests/e2e/run-table-os-archive-e2e.js",
    "test:e2e:subpath": "npm run build && node tests/e2e/run-subpath-e2e.js",
    "test:security": "npm audit --audit-level=high",
    "test": "npm run test:unit && npm run test:e2e && npm run test:e2e:subpath",
    "check:versions": "node scripts/check-native-versions.js",
    "version:sync": "node scripts/check-native-versions.js --write",
    "check:release-metadata": "node scripts/check-release-metadata.js",
    "release:sync": "npm run version:sync && node scripts/check-release-metadata.js --write",
    "check:store-listing": "node scripts/check-store-listing.js",
    "check": "npm run build && npm run check:versions && npm run check:release-metadata && npm run check:store-listing && npm test",
    "assets:store": "node scripts/generate-store-assets.js",
    "check:store-assets": "node scripts/check-store-assets.js",
    "release:candidate": "node scripts/prepare-release-candidate.js",
    "check:release-candidate": "node scripts/check-release-candidate.js"
  },
  "devDependencies": {
    "playwright": "^1.59.1"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/local-notifications": "^8.2.1"
  }
}
